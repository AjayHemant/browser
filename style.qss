/* style.qss */

QMainWindow {
    background-color: #07181d;
}

QToolBar {
    background-color: #07181d;
    border: none;
    padding: 5px;
    spacing: 5px;
}

QPushButton {
    background-color: transparent;
    border: none;
    color: #e0e0e0;
    font-size: 20px;
    padding: 5px 10px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #2c3e50;
}

QPushButton:disabled {
    color: #6c757d;
}

QLineEdit {
    border: 1px solid #343a40;
    border-radius: 20px;
    padding: 6px 12px;
    background-color: #212529;
    color: #f8f9fa;
    font-size: 15px;
}

QLineEdit:focus {
    border-color: #495057;
}
